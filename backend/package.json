{
  "name": "suraksha-setu-api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "overrides": {
    "gaxios@6.7.1": {
      "uuid": "11.1.1"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "migrate": "node --env-file-if-exists=.env src/migrate.js",
    "seed": "node --env-file-if-exists=.env src/seed.js",
    "test": "node --test --test-concurrency=1 test/*.test.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "firebase-admin": "^14.4.0",
    "helmet": "^8.1.0",
    "jose": "^6.1.0",
    "nodemailer": "^10.0.10",
    "pg": "^8.16.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.10",
    "prettier": "^3.9.6",
    "supertest": "^7.1.4"
  }
}
