NODE_ENV=development
PORT=8080
DATABASE_URL=postgres://suraksha:local-development-only@localhost:5432/suraksha
# Generate at least 32 random bytes. Never commit real secrets.
JWT_SECRET=
OTP_PEPPER=
PUBLIC_URL=http://localhost:8080
# Production HTTPS provider endpoint. Receives {phone, code, expiresInSeconds}.
SMS_PROVIDER=local
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
# Development only: OTP delivered to a local file with restricted permissions.
DEV_OTP_FILE=.data/otp.json
FIREBASE_PROJECT_ID=
# Mount service-account credentials outside the repository, or use workload identity.
GOOGLE_APPLICATION_CREDENTIALS=
# Set only behind the single trusted gateway; API port must not be publicly reachable.
PROXY_HOPS=0
BOOTSTRAP_ORG=demo
BOOTSTRAP_ADMIN_PHONE=
