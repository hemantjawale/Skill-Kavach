NODE_ENV=development
PORT=8080
DATABASE_URL=postgres://suraksha:local-development-only@localhost:5432/suraksha

# Optional trusted database provider CA PEM path
DATABASE_CA_CERT=

# Generate at least 32 random characters for each key (Required)
JWT_SECRET=your_32_character_jwt_secret_key_here
OTP_PEPPER=your_32_character_otp_pepper_key_here

PUBLIC_URL=http://localhost:8080

# OTP Provider: "email" (or "smtp"), "local", or "webhook"
OTP_PROVIDER=email
SMS_PROVIDER=email

# Email SMTP Settings (For Email OTP Delivery)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM="SurakshaSetu Safety" <no-reply@surakshasetu.org>

# Twilio SMS Delivery (COMMENTED OUT PER INSTRUCTION)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# TWILIO_MESSAGING_SERVICE_SID=

# Development fallback: OTP written to local file
DEV_OTP_FILE=.data/otp.json

FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

PROXY_HOPS=0
BOOTSTRAP_ORG=demo
BOOTSTRAP_ADMIN_PHONE=+919876543210
