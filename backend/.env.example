# Render free: use Brevo HTTPS API, not SMTP.
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=SurakshaSetu
NODE_ENV=development
PORT=8080
DATABASE_URL=postgres://suraksha:local-development-only@localhost:5432/suraksha
DATABASE_CA_CERT=
JWT_SECRET=
OTP_PEPPER=
PUBLIC_URL=http://localhost:8080
# SMTP is the only production OTP transport. EMAIL_* aliases are supported.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Use your authenticated mailbox or provider-approved sender.
SMTP_FROM=
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
PROXY_HOPS=0
BOOTSTRAP_ORG=demo
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_SECOND_ADMIN_EMAIL=
